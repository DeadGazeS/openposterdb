# === Required ===
# Generate with: openssl rand -hex 32
JWT_SECRET=

# === Optional ===
# Everything below is optional — defaults shown in parentheses.

#TMDB_API_KEY= (optional — artwork; or set in admin UI)
#MDBLIST_API_KEY= (optional — ratings; or set in admin UI)
#OMDB_API_KEY= (optional — ratings; or set in admin UI)
#TRAKT_CLIENT_ID= (optional — ratings; or set in admin UI)
#FANART_API_KEY= (optional — artwork; or set in admin UI)

#CACHE_DIR=/data/cache (optional — default: ./cache)
#DB_DIR=/data/db (optional — default: ./db)
#LISTEN_ADDR=0.0.0.0:3000 (optional)
#STATIC_DIR=/app/dist (optional — web UI build)
#CORS_ORIGIN= (optional)
#COOKIE_SECURE=true (optional — default: true)

#IMAGE_QUALITY=85 (optional)
#IMAGE_MEM_CACHE_MB=512 (optional)
#RATINGS_STALE_SECS=86400 (optional)
#RATINGS_MAX_AGE_SECS=31536000 (optional)
#IMAGE_STALE_SECS=0 (optional)
#EXTERNAL_CACHE_ONLY=false (optional)
#ENABLE_CDN_REDIRECTS=false (optional)
#RATE_LIMIT_RPM=60 (optional, per-IP for image routes)
#RATE_LIMIT_CDN_RPM=240 (optional, per-IP for /c/ CDN routes)
#DISABLE_PUBLIC_PAGES=false (optional)

#ADMIN_USERNAME= (optional — seeds an admin account)
#ADMIN_PASSWORD= (optional)
#FREE_KEY_ENABLED= (optional)

# LOG_LEVEL: debug | info | warn | error | off
#LOG_LEVEL=info (optional)
